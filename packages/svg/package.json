{
  "name": "@underlying/svg",
  "version": "0.1.0-beta.0",
  "description": "SVG path animation for @underlying/core: ride an element along a path or draw a stroke on, physics-first - flick, interrupt, retarget, or scrub. MotionPath and DrawSVG.",
  "license": "MIT",
  "author": "underlyi.ng <contact@underlyi.ng>",
  "keywords": [
    "animation",
    "svg",
    "motionpath",
    "drawsvg",
    "path",
    "stroke",
    "physics",
    "spring"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/underlyingjs/underlying.git",
    "directory": "packages/svg"
  },
  "homepage": "https://github.com/underlyingjs/underlying#readme",
  "bugs": "https://github.com/underlyingjs/underlying/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "@underlying/core": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
