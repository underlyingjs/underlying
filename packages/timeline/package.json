{
  "name": "@underlying/timeline",
  "version": "1.2.0-beta.7",
  "description": "Seekable timelines for @underlying/core: labels, relative positions, nesting, scrub. Physics-shaped composition.",
  "license": "MIT",
  "author": "underlyi.ng <contact@underlyi.ng>",
  "keywords": [
    "animation",
    "timeline",
    "sequence",
    "scrub",
    "physics",
    "spring"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/underlyingjs/underlying.git",
    "directory": "packages/timeline"
  },
  "homepage": "https://github.com/underlyingjs/underlying#readme",
  "bugs": "https://github.com/underlyingjs/underlying/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "@underlying/core": "workspace:*"
  },
  "devDependencies": {
    "@underlying/scroll": "workspace:*",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
