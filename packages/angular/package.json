{
  "name": "@underlying/angular",
  "version": "1.2.0-beta.7",
  "description": "Angular adapter for underlying: standalone directives that bind animate(), scroll, gestures, text and FLIP to your elements, with automatic teardown on destroy.",
  "license": "MIT",
  "author": "underlyi.ng <contact@underlyi.ng>",
  "keywords": [
    "angular",
    "animation",
    "directive",
    "physics",
    "spring",
    "scroll",
    "gestures"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/underlyingjs/underlying.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/underlyingjs/underlying#readme",
  "bugs": "https://github.com/underlyingjs/underlying/issues",
  "sideEffects": false,
  "module": "./dist/fesm2022/underlying-angular.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/underlying-angular.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json"
  },
  "peerDependencies": {
    "@angular/common": "^19.0.0 || ^20.0.0",
    "@angular/core": "^19.0.0 || ^20.0.0"
  },
  "dependencies": {
    "@underlying/core": "workspace:*",
    "@underlying/flip": "workspace:*",
    "@underlying/gestures": "workspace:*",
    "@underlying/scroll": "workspace:*",
    "@underlying/text": "workspace:*",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "jsdom": "^26.1.0",
    "ng-packagr": "^20.0.0",
    "rxjs": "^7.8.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "zone.js": "^0.15.0"
  }
}
