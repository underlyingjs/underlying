{
  "name": "@underlying/react",
  "version": "1.2.0",
  "description": "React adapter for underlying: hooks that bind animate(), gestures, text and FLIP to a ref, with automatic teardown on unmount.",
  "license": "MIT",
  "author": "underlyi.ng <contact@underlyi.ng>",
  "keywords": [
    "react",
    "animation",
    "hooks",
    "physics",
    "spring",
    "gestures"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/underlyingjs/underlying.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/underlyingjs/underlying#readme",
  "bugs": "https://github.com/underlyingjs/underlying/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@underlying/core": "workspace:*",
    "@underlying/flip": "workspace:*",
    "@underlying/gestures": "workspace:*",
    "@underlying/text": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
